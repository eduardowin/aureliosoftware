---
// Barra de anuncio: cuenta atrás a la obligatoriedad de Verifactu.
// Los días se calculan en el navegador, no hay que mantenerlos a mano.
---

<a class="aviso-top" href="/verifactu">
  <span class="aviso-ico" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="M12 2 1 21h22L12 2zm0 4.2 8.1 13.8H3.9L12 6.2zM11 10v5h2v-5h-2zm0 6v2h2v-2h-2z"/></svg>
  </span>
  <span class="aviso-msg">
    <b data-dias>Verifactu</b>
    <span data-sub>ya tiene fecha para tu clínica</span>
  </span>
  <span class="aviso-cta">Comprobar mi programa <span aria-hidden="true">→</span></span>
</a>

<style>
  .aviso-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    flex-wrap: wrap;
    padding: 9px 20px;
    background: var(--ambar);
    color: #101828;
    text-decoration: none;
    font-size: 0.88rem;
    line-height: 1.3;
    text-align: center;
    transition: background 0.14s ease;
  }
  .aviso-top:hover { background: var(--ambar-osc); color: #101828; }
  .aviso-top:hover .aviso-cta { text-decoration-color: #101828; }

  .aviso-ico {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #101828;
    animation: pulso-aviso 2.6s ease-in-out infinite;
  }
  .aviso-ico svg { width: 12px; height: 12px; fill: var(--ambar); }
  @keyframes pulso-aviso {
    0%, 100% { box-shadow: 0 0 0 0 rgba(16, 24, 40, 0.35); }
    60% { box-shadow: 0 0 0 8px rgba(16, 24, 40, 0); }
  }

  .aviso-msg b { font-weight: 700; font-variant-numeric: tabular-nums; }
  .aviso-msg span { opacity: 0.92; }

  .aviso-cta {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(16, 24, 40, 0.4);
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .aviso-top { font-size: 0.82rem; gap: 8px; padding: 8px 16px; }
    .aviso-cta { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .aviso-ico { animation: none; }
  }
</style>

<script>
  // 1 ene 2027: obligatorio para sociedades · 1 jul 2027: resto de obligados
  const HITOS = [
    { fecha: new Date('2027-01-01T00:00:00'), quien: 'para sociedades' },
    { fecha: new Date('2027-07-01T00:00:00'), quien: 'para autónomos' },
  ];

  function pintarAviso() {
    const elDias = document.querySelector('[data-dias]');
    const elSub = document.querySelector('[data-sub]');
    if (!elDias || !elSub) return;

    const ahora = new Date();
    const hito = HITOS.find((h) => h.fecha > ahora);

    if (!hito) {
      elDias.textContent = 'Verifactu ya es obligatorio.';
      elSub.textContent = 'Si tu programa no cumple, te expones a sanciones.';
      return;
    }

    const dias = Math.ceil((hito.fecha.getTime() - ahora.getTime()) / 86400000);
    elDias.textContent =
      dias === 1
        ? 'Queda 1 día'
        : `Quedan ${new Intl.NumberFormat('es-ES').format(dias)} días`;
    elSub.textContent = `para que Verifactu sea obligatorio ${hito.quien}`;
  }

  pintarAviso();
  setInterval(pintarAviso, 60 * 60 * 1000);
</script>
