  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M7 2h2v2h6V2h2v2h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2V2zm12 8H5v10h14V10zm-2.9 1.6 1.4 1.4-5.3 5.3-3.2-3.2 1.4-1.4 1.8 1.8 3.9-3.9z"/>
  </svg>
