---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  faq?: { q: string; a: string }[];
}

const { title, description, canonical, faq } = Astro.props;
const site = 'https://aureliosoftware.es';
const url = canonical ?? new URL(Astro.url.pathname, site).href;

const zonas = [
  'Madrid','Alcobendas','San Sebastián de los Reyes','Tres Cantos',
  'Pozuelo de Alarcón','Las Rozas de Madrid','Majadahonda','Boadilla del Monte',
  'Alcorcón','Móstoles','Leganés','Getafe','Fuenlabrada','Parla','Pinto',
  'Alcalá de Henares','Torrejón de Ardoz','Coslada','San Fernando de Henares',
  'Rivas-Vaciamadrid',
];

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Aurelio Software',
  description:
    'Desarrollo de software a medida, automatizaciones, integraciones, facturación electrónica y asesoría tecnológica para clínicas dentales en Madrid.',
  url: site,
  telephone: '+34663904285',
  email: 'contacto@aureliosoftware.es',
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  areaServed: zonas.map((n) => ({ '@type': 'City', name: n })),
  priceRange: '€€',
  knowsAbout: [
    'Desarrollo de software para clínicas dentales',
    'Verifactu', 'Factura electrónica', 'Automatización de procesos',
    'Integración de sistemas',
  ],
};

const faqSchema = faq && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const nav = [
  { href: '/clinicas-dentales', label: 'Clínicas dentales' },
  { href: '/verifactu', label: 'Verifactu' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/sobre-mi', label: 'Sobre mí' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content="Aurelio Software" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <style is:global>
    :root {
      color-scheme: light;
      --azul: #2f6bff;
      --azul-claro: #1d55e0;
      --azul-tenue: #dfe8ff;
      --oro: #b8912f;
      --fondo: #ffffff;
      --fondo-alt: #f4f8fb;
      --texto: #101828;
      --texto-suave: #5a6577;
      --borde: #e4e8ef;
      --tarjeta: #ffffff;
      --sombra: 0 1px 2px rgba(16,24,40,.04), 0 4px 12px rgba(16,24,40,.05);
      --sombra-alta: 0 2px 4px rgba(16,24,40,.05), 0 12px 28px rgba(16,24,40,.09);
      --max: 1120px;
      --wasap: #25d366;
      --radio: 6px;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--fondo);
      color: var(--texto);
      font: 17px/1.7 system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    img { max-width: 100%; height: auto; }
    [hidden] { display: none !important; }

    h1, h2, h3 { line-height: 1.12; letter-spacing: -0.032em; margin: 0 0 .5em; font-weight: 700; }
    h1 { font-size: clamp(2.3rem, 6vw, 3.9rem); }
    h2 { font-size: clamp(1.7rem, 4vw, 2.6rem); }
    h3 { font-size: 1.2rem; letter-spacing: -0.02em; }
    p { margin: 0 0 1.15em; }
    a { color: var(--azul); text-underline-offset: 3px; }

    .env { max-width: var(--max); margin-inline: auto; padding-inline: 24px; }
    section { padding-block: clamp(72px, 11vw, 136px); }
    main > section:first-child { padding-top: clamp(36px, 5vw, 60px); }
    .alt { background: var(--fondo-alt); }

    .btn {
      display: inline-block; padding: 15px 30px; border-radius: var(--radio);
      background: var(--azul); color: #fff; text-decoration: none;
      font-weight: 600; font-size: .97rem; border: 1.5px solid var(--azul);
      transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
    }
    .btn:hover { background: var(--azul-claro); border-color: var(--azul-claro); transform: translateY(-1px); box-shadow: var(--sombra); }
    .btn-2 { background: transparent; color: var(--azul); border-color: var(--borde); }
    .btn-2:hover { background: var(--azul-tenue); border-color: var(--azul); color: var(--azul); transform: translateY(-1px); box-shadow: none; }
    .btn, .btn-2, .btn-wa { vertical-align: middle; margin-bottom: 10px; }

    .grid { display: grid; gap: 26px; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); }

    .card {
      background: var(--tarjeta); border: 1px solid var(--borde);
      border-radius: var(--radio); padding: 32px 30px;
      box-shadow: var(--sombra); transition: box-shadow .16s ease, transform .16s ease;
    }
    .card:hover { box-shadow: var(--sombra-alta); transform: translateY(-2px); }
    .card h3 { margin-bottom: .45em; }
    .card p { color: var(--texto-suave); margin-bottom: 0; font-size: .97rem; }

    header.top {
      border-bottom: 1px solid var(--borde);
      background: color-mix(in srgb, var(--fondo) 88%, transparent);
      backdrop-filter: saturate(180%) blur(12px);
      position: sticky; top: 0; z-index: 20;
    }
    header.top .env {
      display: flex; align-items: center; justify-content: space-between;
      gap: 18px; padding-block: 17px; flex-wrap: wrap;
    }
    .marca {
      font-weight: 700; font-size: 1.08rem; text-decoration: none;
      color: var(--texto); letter-spacing: -0.03em; white-space: nowrap;
    }
    .marca span { color: var(--texto-suave); font-weight: 500; }
    nav.principal { display: flex; gap: 26px; flex-wrap: wrap; align-items: center; }
    nav.principal a {
      text-decoration: none; color: var(--texto-suave);
      font-size: .94rem; font-weight: 500; transition: color .12s;
    }
    nav.principal a:hover, nav.principal a[aria-current='page'] { color: var(--texto); }

    footer.pie {
      border-top: 1px solid var(--borde); background: var(--fondo-alt);
      padding-block: 64px 40px; font-size: .93rem; color: var(--texto-suave);
    }
    footer.pie .cols { display: grid; gap: 36px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
    footer.pie a { color: var(--texto-suave); text-decoration: none; display: block; padding-block: 4px; transition: color .12s; }
    footer.pie a:hover { color: var(--texto); }
    footer.pie .legal { margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--borde); font-size: .88rem; }

    .eyebrow {
      text-transform: uppercase; letter-spacing: .13em; font-size: .76rem;
      font-weight: 700; color: var(--oro); margin-bottom: 1.1em;
    }
    .lead { font-size: clamp(1.1rem, 2.1vw, 1.3rem); color: var(--texto-suave); line-height: 1.62; }
    .aviso {
      border: 1px solid var(--borde); border-left: 3px solid var(--oro);
      background: var(--tarjeta); padding: 26px 30px; border-radius: var(--radio);
      box-shadow: var(--sombra);
    }
    ul.limpia { list-style: none; padding: 0; margin: 0; }
    ul.limpia li { padding-left: 30px; position: relative; margin-bottom: 13px; }
    ul.limpia li::before {
      content: ''; position: absolute; left: 4px; top: .62em;
      width: 7px; height: 7px; border-radius: 50%; background: var(--oro);
    }
    details { border-bottom: 1px solid var(--borde); padding: 22px 0; }
    details summary { cursor: pointer; font-weight: 600; list-style: none; font-size: 1.04rem; }
    details summary::-webkit-details-marker { display: none; }
    details summary::after { content: '+'; float: right; color: var(--texto-suave); font-weight: 400; font-size: 1.3rem; line-height: 1; }
    details[open] summary::after { content: '2'; }
    details p { margin: 16px 0 0; color: var(--texto-suave); }

    .btn-wa {
      display: inline-flex; align-items: center; gap: 9px;
      padding: 15px 26px; border-radius: var(--radio);
      background: var(--wasap); color: #fff; text-decoration: none;
      font-weight: 600; font-size: .97rem; border: 1.5px solid var(--wasap);
      transition: transform .12s ease, box-shadow .12s ease, filter .12s ease;
    }
    .btn-wa:hover { filter: brightness(.94); transform: translateY(-1px); box-shadow: var(--sombra); color: #fff; }
    .btn-wa svg { width: 19px; height: 19px; fill: currentColor; flex-shrink: 0; }

    .wa-flota {
      position: fixed; right: 20px; bottom: 20px; z-index: 50;
      width: 56px; height: 56px; border-radius: 50%;
      background: var(--wasap); color: #fff;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 14px rgba(16,24,40,.22);
      transition: transform .14s ease, box-shadow .14s ease;
    }
    .wa-flota:hover { transform: scale(1.07); box-shadow: 0 6px 20px rgba(16,24,40,.28); }
    .wa-flota svg { width: 29px; height: 29px; fill: #fff; }
    @media (max-width: 640px) { .wa-flota { right: 16px; bottom: 16px; } }
    @media print { .wa-flota { display: none; } }

    .retrato {
      width: 148px; height: 148px; border-radius: 50%;
      object-fit: cover; box-shadow: var(--sombra-alta);
    }
  </style>
</head>

<body>
  <header class="top">
    <div class="env">
      <a class="marca" href="/">Aurelio<span>&nbsp;Software</span></a>
      <nav class="principal">
        {nav.map((i) => (
          <a href={i.href} aria-current={path === i.href ? 'page' : undefined}>{i.label}</a>
        ))}
        <a class="btn" href="/contacto" style="padding:10px 20px;font-size:.9rem">Diagnóstico gratuito</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <a
    class="wa-flota"
    href="https://wa.me/34663904285?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20software%20para%20mi%20cl%C3%ADnica"
    target="_blank"
    rel="noopener"
    aria-label="Escribir por WhatsApp"
    title="Escríbeme por WhatsApp"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.48s1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.17 8.17 0 0 1-1.25-4.38c0-4.53 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.23-8.25 8.23z"/></svg>
  </a>

  <footer class="pie">
    <div class="env">
      <div class="cols">
        <div>
          <strong style="color:var(--texto)">Aurelio Software</strong>
          <p style="margin-top:8px">
            Software a medida, automatizaciones e integraciones para clínicas
            dentales de Madrid.
          </p>
        </div>
        <div>
          <strong style="color:var(--texto)">Servicios</strong>
          <a href="/servicios#desarrollo">Desarrollo de software</a>
          <a href="/servicios#automatizaciones">Automatizaciones</a>
          <a href="/servicios#integraciones">Integraciones</a>
          <a href="/servicios#facturacion-electronica">Facturación electrónica</a>
          <a href="/servicios#asesorias">Asesorías</a>
        </div>
        <div>
          <strong style="color:var(--texto)">Contacto</strong>
          <a href="mailto:contacto@aureliosoftware.es">contacto@aureliosoftware.es</a>
          <a href="/contacto">Agendar 30 minutos</a>
          <p style="margin-top:8px">Madrid y área metropolitana</p>
        </div>
      </div>
      <div class="legal">
        © {new Date().getFullYear()} Aurelio Software ·
        <a href="/aviso-legal" style="display:inline">Aviso legal</a> ·
        <a href="/privacidad" style="display:inline">Privacidad</a>
      </div>
    </div>
  </footer>
</body>
</html>
