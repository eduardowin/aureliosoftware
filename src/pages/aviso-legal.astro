        <li><strong>Nombre comercial:</strong> Aurelio Software</li>
        <li><strong>NIE:</strong> Y8931217D</li>
        <li><strong>Domicilio:</strong> Calle Manuel Cortina 8, Madrid</li>
        <li><strong>Correo:</strong> contacto@aureliosoftware.es</li>
        <li><strong>Teléfono:</strong> +34 663 90 42 85</li>
        <li><strong>Sitio web:</strong> aureliosoftware.es</li>
