---
import Base from '../layouts/Base.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import servicios from '../data/servicios.json';

const title = 'Aurelio Software · Software a medida para clínicas dentales en Madrid';
const description =
  'Desarrollo a medida, automatizaciones, integraciones, facturación electrónica y asesoría tecnológica para clínicas dentales de Madrid. Primer diagnóstico gratuito.';

const problemas = [
  {
    t: 'Tus programas no se hablan entre sí',
    d: 'El software dental por un lado, la agenda por otro y una hoja de cálculo en recepción. Alguien pasa datos a mano cada semana.',
  },
  {
    t: 'Recepción pierde horas en lo mismo',
    d: 'Llamar uno por uno para recordar citas, perseguir presupuestos sin respuesta, montar el informe del mes a mano.',
  },
  {
    t: 'Verifactu encima, con fecha',
    d: 'Y nadie te ha sabido decir con certeza si el programa que usas cumple o hay que cambiarlo.',
  },
];

const tecnologias = [
  ['.NET / C#', 'El motor de la mayoría de sistemas de gestión sanitaria'],
  ['SQL Server', 'Donde viven los datos de tus pacientes'],
  ['Microsoft Azure', 'Infraestructura en la nube, certificado en plataforma, datos e IA'],
  ['APIs e integraciones', 'Para que tus programas se hablen entre sí'],
  ['WhatsApp Business', 'Recordatorios de cita automáticos'],
  ['Automatización', 'Todo lo que hoy se hace a mano y no debería'],
];

const pasos = [
  ['Diagnóstico', 'Veinte minutos para entender qué usas y dónde se pierde el tiempo. Sin coste ni compromiso.'],
  ['Propuesta cerrada', 'Un plan por fases con precio cerrado por fase. Sabes lo que cuesta antes de empezar.'],
  ['Entrega por fases', 'Cada fase se pone en marcha y se paga sola antes de abordar la siguiente.'],
  ['Soporte', 'Acompañamiento continuo con tiempos de respuesta acordados.'],
];
---

<Base title={title} description={description}>
  <section>
    <div class="env" style="max-width:780px">
      <p class="eyebrow">Madrid y área metropolitana</p>
      <h1>Software a medida para clínicas dentales que están hartas de que sus programas no se hablen entre sí</h1>
      <p class="lead">
        Desarrollo, automatizaciones, integraciones, facturación electrónica y
        asesoría tecnológica. Trabajo sobre lo que ya tienes en vez de obligarte
        a cambiarlo todo.
      </p>
      <p style="margin-top:28px">
        <a class="btn" href="/contacto">Diagnóstico gratuito de 20 min</a>
        <BotonWhatsApp texto="WhatsApp" style="margin-left:10px" />
        <a class="btn-alerta" href="/verifactu" style="margin-left:10px">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 1 21h22L12 2zm0 4.2 8.1 13.8H3.9L12 6.2zM11 10v5h2v-5h-2zm0 6v2h2v-2h-2z"/></svg>
          ¿Cumplo Verifactu?
        </a>
      </p>
    </div>
  </section>

  <section class="alt">
    <div class="env">
      <h2>Si diriges una clínica, esto te suena</h2>
      <div class="grid" style="margin-top:32px">
        {problemas.map((p) => (
          <div class="card">
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="env">
      <p class="eyebrow">Cinco líneas de trabajo</p>
      <h2>En qué puedo ayudarte</h2>
      <div class="grid" style="margin-top:32px">
        {servicios.map((s) => (
          <div class="card">
            <h3>{s.titulo}</h3>
            <p style="color:var(--texto);font-weight:500;margin-bottom:.5em">{s.gancho}</p>
            <p>{s.descripcion}</p>
            <p style="margin-top:14px">
              <a href={`/servicios#${s.id}`} style="font-weight:600;font-size:.93rem">Ver detalle →</a>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="env" style="max-width:760px">
      <div class="aviso">
        <p class="eyebrow" style="margin-bottom:.5em">Obligatorio, con fecha</p>
        <h2 style="font-size:1.6rem">Verifactu llega en 2027</h2>
        <p>
          Todo programa de facturación tendrá que generar registros trazables con
          código QR verificable. <strong>1 de enero de 2027</strong> para
          sociedades y <strong>1 de julio de 2027</strong> para el resto, con
          sanciones que pueden superar los 50.000 €.
        </p>
        <p style="margin-bottom:0">
          En veinte minutos te digo si el programa que usas cumple, se puede
          adaptar o hay que cambiarlo.
        </p>
        <p style="margin:20px 0 0">
          <a class="btn" href="/verifactu">Comprobar mi software</a>
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="env">
      <p class="eyebrow">El proceso</p>
      <h2>Cómo trabajo</h2>
      <div class="pasos">
        {pasos.map(([t, d], i) => (
          <div class="paso">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{t}</h3>
              <p>{d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="env">
      <p class="eyebrow">Con qué trabajo</p>
      <h2>Tecnología, no promesas</h2>
      <div class="tecno">
        {tecnologias.map(([t, d]) => (
          <div class="tec">
            <strong>{t}</strong>
            <span>{d}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="env" style="max-width:720px;text-align:center">
      <h2>Empecemos por entender tu clínica</h2>
      <p class="lead">
        Veinte minutos, sin coste y sin compromiso. Salgas o no conmigo, te llevas un
        diagnóstico de qué se puede mejorar y por dónde empezar.
      </p>
      <p style="margin-top:24px">
        <a class="btn" href="/contacto">Agendar 20 minutos</a>
        <BotonWhatsApp style="margin-left:10px" />
      </p>
    </div>
  </section>
</Base>

<style>
  .pasos {
    margin-top: 44px;
    display: grid;
    gap: 40px 48px;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  }
  .paso { display: flex; gap: 22px; align-items: flex-start; }
  .paso .num {
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--borde);
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .paso h3 { margin-bottom: .35em; }
  .paso p { color: var(--texto-suave); margin-bottom: 0; font-size: .97rem; }

  .tecno {
    margin-top: 44px;
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    background: var(--borde);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    overflow: hidden;
  }
  .tec {
    background: var(--tarjeta);
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .tec strong { font-size: 1.06rem; letter-spacing: -0.02em; }
  .tec span { color: var(--texto-suave); font-size: .94rem; line-height: 1.55; }
</style>
