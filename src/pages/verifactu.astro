---
import Base from '../layouts/Base.astro';
import BotonCita from '../components/BotonCita.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';

const title = 'Verifactu para clínicas dentales · ¿Cumple tu programa? | Aurelio Software';
const description =
  'Verifactu es obligatorio desde enero de 2027 para sociedades y julio de 2027 para el resto. Auditoría gratuita de 20 minutos para clínicas dentales de Madrid.';

const faq = [
  {
    q: '¿Qué es Verifactu exactamente?',
    a: 'Es el reglamento que obliga a que todo programa de facturación genere registros encadenados e inalterables, incluya un código QR verificable en cada factura y, si operas en modo Verifactu, los remita a la Agencia Tributaria. El objetivo es que una factura no se pueda modificar ni borrar después de emitida.',
  },
  {
    q: '¿Cuándo es obligatorio para mi clínica?',
    a: 'Si la clínica es una sociedad y tributa por el Impuesto sobre Sociedades, desde el 1 de enero de 2027. Para el resto, desde el 1 de julio de 2027. El plazo para autónomos se aplazó desde julio de 2026, así que conviene comprobar siempre la fecha vigente.',
  },
  {
    q: '¿Tengo que cambiar de programa dental?',
    a: 'En la mayoría de casos no. Muchos fabricantes están sacando versiones adaptadas, y a veces basta con actualizar o con conectar un módulo de facturación conforme. Solo cuando el programa está descontinuado o el fabricante no va a adaptarlo hay que plantear el cambio.',
  },
  {
    q: '¿Qué pasa si no cumplo?',
    a: 'El reglamento contempla sanciones que pueden superar los 50.000 €, especialmente si se considera que el software permite ocultar ingresos o alterar la facturación. La responsabilidad alcanza tanto a quien usa el programa como a quien lo fabrica.',
  },
  {
    q: '¿La auditoría es realmente gratuita?',
    a: 'Sí. Son veinte minutos en los que revisamos qué programa usas, en qué versión y qué dice su fabricante sobre la adaptación. Sales con una respuesta clara: cumple, se adapta o hay que cambiarlo. Sin compromiso de contratar nada.',
  },
  {
    q: '¿Y la factura electrónica B2B, es lo mismo?',
    a: 'No, son dos obligaciones distintas que se solapan. Verifactu regula cómo tu programa genera y conserva los registros. La factura electrónica B2B de la Ley Crea y Crece regula cómo envías la factura a otras empresas, en formato estructurado y a través de plataforma habilitada. Cuando ambas estén activas, una factura B2B tendrá que cumplir las dos.',
  },
];

const escenarios = [
  {
    n: '1',
    t: 'Tu programa ya cumple',
    d: 'El fabricante ha sacado versión adaptada y solo hay que actualizar y configurar. Te lo confirmo y no necesitas nada más de mí.',
  },
  {
    n: '2',
    t: 'Se puede adaptar',
    d: 'El programa sirve, pero le falta el módulo conforme o hay que conectarlo con una solución de facturación que sí cumpla. Eso lo implanto yo.',
  },
  {
    n: '3',
    t: 'Hay que cambiarlo',
    d: 'El programa está descontinuado o el fabricante no va a adaptarlo. Aquí toca migrar, y lo importante es no perder el histórico de pacientes.',
  },
];
---

<Base title={title} description={description} faq={faq}>
  <section>
    <div class="env" style="max-width:780px">
      <p class="eyebrow">Obligatorio · Con fecha · Con sanción</p>
      <h1>¿Tu programa de facturación cumple Verifactu?</h1>
      <p class="lead">
        Si diriges una clínica dental en Madrid y no tienes una respuesta clara a
        esa pregunta, en veinte minutos te la doy. Sin coste y sin compromiso.
      </p>
      <p style="margin-top:28px">
        <BotonCita texto="Auditoría gratuita de 20 min" />
        <BotonWhatsApp mensaje="Hola, quiero saber si mi programa de facturación cumple Verifactu" texto="WhatsApp" style="margin-left:10px" />
      </p>
    </div>
  </section>

  <section class="alt">
    <div class="env" style="max-width:820px">
      <h2>Las fechas</h2>
      <div style="overflow-x:auto;margin-top:24px">
        <table style="width:100%;border-collapse:collapse;min-width:420px">
          <thead>
            <tr style="border-bottom:2px solid var(--borde);text-align:left">
              <th style="padding:12px 10px">Quién</th>
              <th style="padding:12px 10px">Desde cuándo</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom:1px solid var(--borde)">
              <td style="padding:12px 10px">Clínicas constituidas como sociedad</td>
              <td style="padding:12px 10px"><strong>1 de enero de 2027</strong></td>
            </tr>
            <tr style="border-bottom:1px solid var(--borde)">
              <td style="padding:12px 10px">Resto de obligados</td>
              <td style="padding:12px 10px"><strong>1 de julio de 2027</strong></td>
            </tr>
            <tr>
              <td style="padding:12px 10px">Factura electrónica B2B (Crea y Crece)</td>
              <td style="padding:12px 10px">Implantación progresiva desde octubre de 2027</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top:20px;color:var(--texto-suave)">
        Las sanciones por usar software no conforme pueden superar los 50.000 €.
        Los plazos han cambiado más de una vez, así que conviene verificarlos
        cuando abordes la adaptación.
      </p>
    </div>
  </section>

  <section>
    <div class="env">
      <h2>Qué exige la norma, en lenguaje llano</h2>
      <ul class="limpia" style="margin-top:24px;max-width:700px">
        <li>Cada factura genera un <strong>registro encadenado</strong> con la anterior, de forma que no se puede modificar ni borrar sin que quede rastro.</li>
        <li>Cada factura lleva un <strong>código QR verificable</strong> que permite comprobar su autenticidad.</li>
        <li>En modo Verifactu, los registros <strong>se remiten a la Agencia Tributaria</strong> de forma automática.</li>
        <li>El programa debe llevar una <strong>declaración responsable</strong> del fabricante que certifique el cumplimiento.</li>
      </ul>
    </div>
  </section>

  <section class="alt">
    <div class="env">
      <h2>Tres escenarios posibles</h2>
      <div class="grid" style="margin-top:32px">
        {escenarios.map((e) => (
          <div class="card">
            <p class="eyebrow" style="margin-bottom:.4em">Escenario {e.n}</p>
            <h3>{e.t}</h3>
            <p>{e.d}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:28px;max-width:700px;color:var(--texto-suave)">
        La mayoría de clínicas están en el escenario 1 o en el 2. Antes de
        plantearte cambiar de programa, conviene saber en cuál estás.
      </p>
    </div>
  </section>

  <section>
    <div class="env" style="max-width:760px">
      <h2>Preguntas frecuentes</h2>
      <div style="margin-top:24px">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="env" style="max-width:720px;text-align:center">
      <h2>Veinte minutos y sales de dudas</h2>
      <p class="lead">
        Me dices qué programa usas y en qué versión. Te digo si cumple, si se
        adapta o si hay que cambiarlo, y qué coste tendría cada camino.
      </p>
      <p style="margin-top:24px">
        <BotonCita texto="Agendar auditoría gratuita" />
        <BotonWhatsApp mensaje="Hola, quiero saber si mi programa de facturación cumple Verifactu" style="margin-left:10px" />
      </p>
    </div>
  </section>
</Base>
